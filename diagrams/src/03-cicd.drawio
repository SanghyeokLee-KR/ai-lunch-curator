<mxfile host="app.diagrams.net">
  <diagram name="CI/CD 파이프라인" id="cicd">
    <mxGraphModel dx="1400" dy="760" grid="0" pageWidth="1240" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="title" value="CI/CD 파이프라인" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="44" y="26" width="500" height="30" as="geometry" /></mxCell>
        <mxCell id="rule" value="" style="rounded=1;fillColor=#C2613D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="46" y="58" width="46" height="4" as="geometry" /></mxCell>

        <mxCell id="band1" value="① main push → 테스트 게이트 → 배포" style="text;html=1;align=left;fontSize=12;fontColor=#9AA0AA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="90" width="500" height="18" as="geometry" /></mxCell>

        <mxCell id="dev" value="&lt;b&gt;개발자&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;git push (main)&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#E5E7EB;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="128" height="78" as="geometry" /></mxCell>
        <mxCell id="repo" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;main 브랜치&lt;/span&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#E5E7EB;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=46;fontSize=13;" vertex="1" parent="1"><mxGeometry x="222" y="150" width="150" height="78" as="geometry" /></mxCell>
        <mxCell id="ci" value="&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;setup-python 3.12&lt;br&gt;pip install&lt;br&gt;pytest (외부 호출 목킹)&lt;/span&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#2088FF;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=46;fontSize=13;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="126" width="216" height="126" as="geometry" /></mxCell>
        <mxCell id="gate" value="테스트&lt;br&gt;통과?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#E0A800;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="694" y="156" width="110" height="66" as="geometry" /></mxCell>
        <mxCell id="deploy" value="&lt;b&gt;deploy.yml&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;needs: ci 통과&lt;br&gt;SSH → git pull&lt;br&gt;.env(Secrets) 주입&lt;br&gt;docker compose up -d&lt;/span&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#2088FF;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=46;fontSize=13;" vertex="1" parent="1"><mxGeometry x="846" y="120" width="250" height="140" as="geometry" /></mxCell>
        <mxCell id="ec2" value="&lt;b&gt;EC2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;배포&lt;/span&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#FFF5EC;strokeColor=#ED7100;image=data:image/svg+xml,;imageWidth=30;imageHeight=30;imageAlign=center;imageVerticalAlign=top;align=center;verticalAlign=bottom;spacingBottom=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1132" y="150" width="92" height="80" as="geometry" /></mxCell>

        <mxCell id="ed1" value="push" style="html=1;endArrow=block;rounded=1;strokeColor=#8A94A6;fontColor=#566173;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dev" target="repo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" value="트리거" style="html=1;endArrow=block;rounded=1;strokeColor=#8A94A6;fontColor=#566173;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repo" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed3" value="" style="html=1;endArrow=block;rounded=1;strokeColor=#8A94A6;" edge="1" parent="1" source="ci" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed4" value="통과 ✓" style="html=1;endArrow=block;rounded=1;strokeColor=#2E9E5B;fontColor=#2E9E5B;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed5" value="" style="html=1;endArrow=block;rounded=1;strokeColor=#8A94A6;" edge="1" parent="1" source="deploy" target="ec2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="fail" value="실패 시 배포 중단" style="text;html=1;align=center;fontSize=11;fontColor=#D14343;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="252" width="160" height="20" as="geometry" /></mxCell>
        <mxCell id="edfail" value="실패 ✗" style="html=1;endArrow=block;rounded=1;strokeColor=#D14343;fontColor=#D14343;fontSize=11;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="gate" target="fail"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="sep" value="" style="line;strokeColor=#ECEEF1;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="1184" height="8" as="geometry" /></mxCell>
        <mxCell id="band2" value="② 스케줄 트리거 (cron) — 워크플로가 공개 엔드포인트를 토큰으로 호출" style="text;html=1;align=left;fontSize=12;fontColor=#9AA0AA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="44" y="338" width="700" height="18" as="geometry" /></mxCell>
        <mxCell id="sched" value="&lt;b&gt;스케줄 워크플로&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6B7280;font-size:11px&quot;&gt;weekly-menu.yml — 월 08:30 KST&lt;br&gt;daily-notify.yml — 평일 09:00 KST&lt;/span&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#E5E7EB;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;align=left;spacingLeft=46;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="368" width="332" height="100" as="geometry" /></mxCell>
        <mxCell id="edsched" value="POST /api/collect-weekly · /api/send-today   (+ Bearer 토큰)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#8A94A6;fontColor=#566173;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sched" target="ec2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="push → 테스트 통과해야만 배포 · 무거운 작업은 백그라운드 처리 · 비밀값은 GitHub Secrets로 주입(.env는 커밋하지 않음)" style="text;html=1;align=left;fontSize=12;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="44" y="512" width="1100" height="20" as="geometry" /></mxCell>
