# 실제 값을 채운 뒤 이 파일을 .env 로 복사해서 쓴다. (.env 는 절대 커밋 금지)

# --- OpenAI ---
OPENAI_API_KEY=sk-여기에_실제_키
# 모델명은 바뀌니 env 로 관리. 필요하면 최신 모델로 올리면 된다.
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Teams Workflows 웹훅 (옛 Incoming Webhook 커넥터 아님) ---
# Workflows > "Post to a channel when a webhook request is received" 로 발급한 URL
WEBHOOK_URL=https://prod-00.koreacentral.logic.azure.com:443/workflows/xxxx/triggers/manual/paths/invoke?...

# --- 배포 주소 ---
# https 여야 Teams 카드에 생성 이미지가 렌더된다. 로컬/임시면 http 라도 동작(텍스트+링크 카드).
APP_BASE_URL=http://localhost:8000

# --- 사내 식단표 소스 (아직 미정) ---
# 비워두면 샘플 데이터로 동작한다. 실제 소스가 정해지면 URL 을 넣고 scraper 셀렉터를 맞춘다.
MENU_SOURCE_URL=

# --- Oracle (Docker Compose) ---
# ORACLE_USER/PASSWORD = 앱 전용 유저(자동 생성), ORACLE_ADMIN_PASSWORD = SYS/SYSTEM
# ORACLE_DSN 은 호스트 도구용(localhost). 컨테이너 안에선 compose 가 oracle:1521 로 덮어쓴다.
ORACLE_USER=lunch
ORACLE_PASSWORD=change-me-app-pw
ORACLE_ADMIN_PASSWORD=change-me-admin-pw
ORACLE_DSN=localhost:1521/XEPDB1

# --- 수집/발송 트리거 보호 토큰 (Phase 4 POST 엔드포인트) ---
COLLECT_TOKEN=change-me-long-random-token
